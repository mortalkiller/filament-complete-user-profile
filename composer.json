{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mortalkiller/filament-complete-user-profile",
    "description": "A complete, modular user account center for Filament 5.",
    "keywords": [
        "filament",
        "laravel",
        "profile",
        "multi-factor-authentication",
        "sanctum"
    ],
    "homepage": "https://github.com/mortalkiller/filament-complete-user-profile",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/mortalkiller/filament-complete-user-profile/issues",
        "source": "https://github.com/mortalkiller/filament-complete-user-profile"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": ">=5.8.3 <6.0.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "mortalkiller/filament-page-header": "^2.3.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "laravel/sanctum": "^4.3",
        "mortalkiller/filament-package-standard": "^2.0",
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^12.5",
        "spatie/laravel-settings": "^3.9"
    },
    "suggest": {
        "laravel/sanctum": "Required only when the API Tokens feature is enabled."
    },
    "autoload": {
        "psr-4": {
            "Mortalkiller\\FilamentCompleteUserProfile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mortalkiller\\FilamentCompleteUserProfile\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mortalkiller\\FilamentCompleteUserProfile\\CompleteUserProfileServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "browser:prepare": [
            "@php bin/prepare-workbench.php",
            "@php workbench/artisan package:discover",
            "@php workbench/artisan migrate:fresh --force",
            "@php workbench/artisan storage:link --force",
            "@php workbench/artisan filament:assets"
        ]
    }
}
