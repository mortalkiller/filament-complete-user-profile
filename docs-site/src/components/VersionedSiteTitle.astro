---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
const root = '/filament-complete-user-profile';
const version = process.env.DOCS_RELEASE_VERSION || 'Development';
---
<div class="versioned-site-title">
  <SiteTitle {...Astro.props} />
  <div class="docs-version-picker">
    <select class="docs-version-select" aria-label="Documentation version" data-docs-root={root} disabled>
      <option>{version}</option>
    </select>
    <svg class="docs-version-chevron" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
      <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z" />
    </svg>
  </div>
</div>
<script>
  for (const select of document.querySelectorAll<HTMLSelectElement>('select[data-docs-root]')) {
    const root = select.dataset.docsRoot;
    if (!root) continue;
    fetch(`${root}/versions.json`, { cache: 'no-cache' })
      .then((response) => { if (!response.ok) throw new Error('Version manifest unavailable.'); return response.json(); })
      .then((manifest) => {
        if (manifest.schema !== 1 || !manifest.channels || typeof manifest.channels !== 'object') return;
        const entries = Object.entries(manifest.channels)
          .filter(([major, tag]) => /^(0|[1-9]\d*)\.x$/.test(major) && typeof tag === 'string' && /^v\d+\.\d+\.\d+$/.test(tag))
          .sort(([left], [right]) => Number.parseInt(right) - Number.parseInt(left));
        const options: HTMLOptionElement[] = [];
        if (manifest.latest) options.push(new Option(`Latest (${manifest.latest})`, `${root}/`));
        for (const [major, tag] of entries) options.push(new Option(`${major} (${tag})`, `${root}/${major}/`));
        if (!options.length) return;
        select.replaceChildren(...options);
        const major = entries.find(([channel]) => location.pathname.startsWith(`${root}/${channel}/`));
        select.value = major ? `${root}/${major[0]}/` : `${root}/`;
        select.disabled = false;
        select.addEventListener('change', () => { location.assign(select.value); });
      })
      .catch(() => { /* Development and unpublished versions do not have a public manifest. */ });
  }
</script>
